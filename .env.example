# Contact API configuration.
#
# Copy to .env for local `vercel dev`, and set the same keys in the Vercel
# dashboard under Settings -> Environment Variables for deployed builds.
#
# None of these may be prefixed VITE_ — that prefix ships the value to the
# browser in the client bundle. These are server-only.

# --- Delivery (Resend) ---------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries land.
CONTACT_TO_EMAIL=you@example.com

# Sender. Must be on a domain verified in Resend, otherwise delivery fails.
# Leave unset to use Resend's shared onboarding@resend.dev sender, which only
# delivers to the email address that owns the Resend account — fine for
# testing, not for production.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>

# --- Rate limiting -------------------------------------------------------
# Nothing to configure. Limits are 1/minute, 5/hour and 15/day per IP, counted
# in the serverless function's own memory.
#
# That memory is per-instance and is wiped on a cold start, so the caps hold
# against an impatient visitor and casual scripted abuse, not against someone
# patient enough to wait one out. Moving to a shared store is the upgrade path
# if real abuse ever shows up.

# --- Origin allowlist (optional) -----------------------------------------
# Not needed in normal operation. The API accepts any request whose Origin
# matches the host it was addressed to, so the production alias, preview
# deployments, custom domains and localhost all work with no configuration.
#
# Only set this if the page is ever served from a different host than the API.
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
